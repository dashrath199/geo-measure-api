# Copy this file to `.env` and adjust values for your environment.
# Every variable is read by `app.config.Settings` (pydantic-settings).
# `.env` is git-ignored; this example file is safe to commit.

# Application name reported by the API and docs title.
APP_NAME=Geo Measure API

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Debug marker logged at startup only. Error responses never expose
# verbose details or tracebacks, whatever this is set to. Keep false
# in production.
DEBUG=false

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Host and port for local serving (uvicorn defaults; start the API with
# `uvicorn app.main:app --host 127.0.0.1 --port 8000`).
HOST=127.0.0.1
PORT=8000

# Prefix under which all versioned API routes are mounted (health is exempt).
API_PREFIX=/api

# SQLAlchemy database URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./geo_measure.db

# Maximum accepted upload size in megabytes (1-1024).
MAX_UPLOAD_MB=10

# Maximum features accepted per uploaded dataset (1-10000000).
# Bounds processing time and measurements-response size for files that
# are within the byte limit but densely packed.
MAX_FEATURES=50000

# Directory where uploaded files are stored (created on demand).
STORAGE_DIR=uploads
