# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environment variables (real values never committed)
.env

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.hypothesis/

# SQLite databases (persistence artifacts)
*.db
*.sqlite
*.sqlite3

# Uploaded / temporary geospatial data (runtime dirs at the repository
# root — anchored with a leading slash so source packages such as
# app/storage/ are never matched and every module stays tracked)
/tmp/
/uploads/
/storage/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
